# Get this from your Neon project dashboard. Never add this file with real values to Git.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require"
# Use a random, 32+ character production secret. Example: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3001
# Set to development or personal to return the generated OTP in the API response.
# Production mode never returns an OTP; connect an approved delivery service before using it publicly.
AUTH_MODE=personal
